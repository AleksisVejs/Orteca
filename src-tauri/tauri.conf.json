{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orteca",
  "version": "0.1.0",
  "identifier": "app.orteca",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orteca",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#0F0F0E",
        "decorations": true
      }
    ],
    "security": { "csp": "default-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
