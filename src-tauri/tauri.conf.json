{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orteca",
  "version": "0.1.0",
  "identifier": "app.orteca",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orteca",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#08090A",
        "decorations": true
      }
    ],
    "security": { "csp": "default-src 'self'; frame-src http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Orteca",
    "shortDescription": "Run coding agents over a local git repo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
